# Server-only settings for /login and /sign-up (app/api/auth/*). Copy to .env.local
# (or set on the production server). Never prefix these with NEXT_PUBLIC_.
TUBELIGHT_PORTAL_URL=https://portal.tubelightcommunications.com
# "Token" used by the portal 2FA send-otp API
TUBELIGHT_API_TOKEN=
# Shared secret the portal uses to AES-encrypt sign-up payloads
TUBELIGHT_ENC_SECRET=
